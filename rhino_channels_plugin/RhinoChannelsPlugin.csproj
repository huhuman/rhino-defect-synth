<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net7.0-windows</TargetFrameworks>
    <RootNamespace>RhinoChannelsPlugin</RootNamespace>
    <AssemblyName>RhinoChannelsPlugin</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <Platforms>AnyCPU</Platforms>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <PropertyGroup>
    <RhinoCommonPath Condition="'$(RhinoCommonPath)' == ''">C:\Program Files\Rhino 8\System\RhinoCommon.dll</RhinoCommonPath>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Reference Include="RhinoCommon">
      <HintPath>$(RhinoCommonPath)</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.Drawing" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net7.0-windows'">
    <Reference Include="RhinoCommon">
      <HintPath>$(RhinoCommonPath)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
